<?php
// amu_survey_system/includes/header.php

// Ensure session is started (ideally once, e.g., in config.php)
if (session_status() == PHP_SESSION_NONE) {
    session_start();
}

// Ensure BASE_URL, SITE_NAME are defined (from config.php)
if (!defined('BASE_URL')) {
    @include_once __DIR__ . '/../config/config.php';
    if (!defined('BASE_URL')) { // Double check after include attempt
        // Fallback if still not defined, though this indicates a setup issue
        // Forcing a value here might mask underlying problems but can help in dev
        // define('BASE_URL', '/amu_survey_system/'); // Example, adjust to your setup if config.php fails
        // define('SITE_NAME', 'AMU Survey System');
        // error_log("Warning: BASE_URL or SITE_NAME not defined. Header.php used fallback.");
        die("Critical Error: BASE_URL is not defined. Please check your config.php setup.");
    }
}

// Ensure DB connection ($conn) is available (from db_connect.php, likely via config.php)
if (!isset($conn)) {
    @include_once __DIR__ . '/db_connect.php';
    if (!isset($conn) && basename($_SERVER['PHP_SELF']) !== 'login.php' && basename($_SERVER['PHP_SELF']) !== 'register.php') {
        // Don't die on login/register if DB isn't strictly needed before form submission
        // but log it for other pages.
        // error_log("Warning: Database connection (\$conn) not established in header.php for page: " . basename($_SERVER['PHP_SELF']));
    }
}

// Variables for page-specific classes (can be set by the including page)
$body_classes_value = isset($body_class) ? htmlspecialchars($body_class) : '';
$container_classes_value = isset($page_container_class) ? htmlspecialchars($page_container_class) : '';

// Determine if we are in a special section (admin/creator) to adjust header/nav
// This check is simplified; a more robust routing system would be better for complex apps.
$is_admin_section = (isset($_SERVER['REQUEST_URI']) && strpos($_SERVER['REQUEST_URI'], '/admin/') !== false);
$is_creator_section = (isset($_SERVER['REQUEST_URI']) && strpos($_SERVER['REQUEST_URI'], '/survey_creator/') !== false);

// Check if this header is being included by _admin_header.php or _creator_header.php
// Those files will handle their own specific <header> and <nav> elements.
// We use a flag that those specific headers can set.
$is_subsection_header = (isset($is_admin_specific_header) && $is_admin_specific_header === true) ||
                        (isset($is_creator_specific_header) && $is_creator_specific_header === true);

?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?php echo isset($page_title) ? htmlspecialchars($page_title) . ' | ' : ''; echo htmlspecialchars(SITE_NAME ?? 'Survey System'); ?></title>
<!-- Main Stylesheet -->
<link rel="stylesheet" href="<?php echo htmlspecialchars(BASE_URL); ?>css/style.css">

<!-- Conditional Stylesheets for specific sections (loaded by their own headers typically) -->
<?php if ($is_admin_section && file_exists(__DIR__ . '/../admin/css/admin_style.css')): ?>
    <link rel="stylesheet" href="<?php echo htmlspecialchars(BASE_URL); ?>admin/css/admin_style.css">
<?php elseif ($is_creator_section && file_exists(__DIR__ . '/../survey_creator/css/creator_style.css')): ?>
    <link rel="stylesheet" href="<?php echo htmlspecialchars(BASE_URL); ?>survey_creator/css/creator_style.css">
<?php endif; ?>

<!-- Optional: Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

<!-- Add page-specific head content if $page_specific_head is set by the calling page -->
<?php echo isset($page_specific_head) ? $page_specific_head : ''; ?>
</head>
<body class="<?php echo $body_classes_value; ?>">
<?php
// Display a general public header/nav ONLY IF this header is NOT being used as a base
// by a section-specific header (like _admin_header.php or _creator_header.php)
// AND the page itself isn't an admin/creator page directly including this.
// For take_survey.php (in root), $is_subsection_header will be false, $is_admin_section and $is_creator_section also false.
if (!$is_subsection_header && !$is_admin_section && !$is_creator_section):
?>
<header class="site-public-header"> <!-- Styled by main style.css -->
    <div class="header-content container"> <!-- Use .container for width consistency -->
        <h1><a href="<?php echo htmlspecialchars(BASE_URL); ?>"><?php echo htmlspecialchars(SITE_NAME ?? 'AMU Surveys'); ?></a></h1>
        <nav class="public-main-nav">
            <ul>
                <li><a href="<?php echo htmlspecialchars(BASE_URL); ?>">Home</a></li>
                <?php if (isset($_SESSION['user_id'])): ?>
                    <li><a href="<?php echo htmlspecialchars(BASE_URL . 'dashboard.php'); ?>">My Dashboard</a></li>
                    <li><a href="<?php echo htmlspecialchars(BASE_URL . 'logout.php'); ?>">Logout (<?php echo htmlspecialchars($_SESSION['username'] ?? ''); ?>)</a></li>
                <?php else: ?>
                    <li><a href="<?php echo htmlspecialchars(BASE_URL . 'respondent/available_surveys.php'); ?>">Available Surveys</a></li>
                    <li><a href="<?php echo htmlspecialchars(BASE_URL . 'login.php'); ?>">Login</a></li>
                    <li><a href="<?php echo htmlspecialchars(BASE_URL . 'register.php'); ?>">Register</a></li>
                <?php endif; ?>
            </ul>
        </nav>
    </div>
</header>
<?php
endif; // <<<<<<<<<< THIS WAS THE MISSING ENDIF
?>

<main class="container <?php echo $container_classes_value; ?>" style="padding-top: 20px; padding-bottom: 20px;"> <!-- Main content wrapper -->
    <?php
    // Display session-based messages (success, error, info)
    if (isset($_SESSION['message'])): ?>
        <div class="alert <?php echo isset($_SESSION['message_type']) ? 'alert-' . htmlspecialchars($_SESSION['message_type']) : 'alert-info'; ?>">
            <?php
            echo htmlspecialchars($_SESSION['message']);
            unset($_SESSION['message']); // Important: Clear the message after displaying it once
            unset($_SESSION['message_type']);
            ?>
        </div>
    <?php endif; ?>
    <!-- Content of the specific page will be inserted here by PHP -->